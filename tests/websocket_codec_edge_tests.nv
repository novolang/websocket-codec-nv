@test
fn test_an_upgrade_that_is_not_a_get_at_http11_is_refused() [io]
    test.case("a POST")
    let posted = H1Request { method: Post, target: "/chat", version: Http11,
                             headers: h1msg.headers(upgrade_fields("13")) }
    match wshandshake.check_upgrade_request(posted)
        Ok(_)  => test.fail("§ 4.1 requires a GET")
        Err(e) =>
            match e
                NotAGetAtHttp11 => test.assert(true)
                _               => test.fail("the refusal names the shape")

    test.case("an HTTP/1.0 GET")
    let old = H1Request { method: Get, target: "/chat", version: Http10,
                          headers: h1msg.headers(upgrade_fields("13")) }
    match wshandshake.check_upgrade_request(old)
        Ok(_)  => test.fail("§ 4.1 requires HTTP/1.1")
        Err(e) =>
            match e
                NotAGetAtHttp11 => test.assert(true)
                _               => test.fail("the refusal names the shape")

@test
fn test_each_missing_handshake_field_is_named_on_its_own() [io]
    test.case("Upgrade: h2c")
    let wrong = a_get([
        H1Header { name: "Upgrade", value: "h2c" },
        H1Header { name: "Connection", value: "Upgrade" },
        H1Header { name: "Sec-WebSocket-Key", value: the_rfc_client_key() },
        H1Header { name: "Sec-WebSocket-Version", value: "13" }])
    match wshandshake.check_upgrade_request(wrong)
        Ok(_)  => test.fail("h2c is not websocket")
        Err(e) =>
            match e
                WrongUpgradeToken(token) => test.assert(token == "h2c")
                _                        => test.fail("the refusal quotes the token")

    test.case("Connection: keep-alive")
    let keepalive = a_get([
        H1Header { name: "Upgrade", value: "websocket" },
        H1Header { name: "Connection", value: "keep-alive" },
        H1Header { name: "Sec-WebSocket-Key", value: the_rfc_client_key() },
        H1Header { name: "Sec-WebSocket-Version", value: "13" }])
    match wshandshake.check_upgrade_request(keepalive)
        Ok(_)  => test.fail("the connection must be the upgrade")
        Err(e) =>
            match e
                MissingConnectionUpgrade => test.assert(true)
                _                        => test.fail("the refusal names the field")

    test.case("no key at all")
    let keyless = a_get([
        H1Header { name: "Upgrade", value: "websocket" },
        H1Header { name: "Connection", value: "Upgrade" },
        H1Header { name: "Sec-WebSocket-Version", value: "13" }])
    match wshandshake.check_upgrade_request(keyless)
        Ok(_)  => test.fail("the key is what the accept answers")
        Err(e) =>
            match e
                MissingKey => test.assert(true)
                _          => test.fail("the refusal names the field")

    test.case("a key that is not the base64 of sixteen bytes")
    let short = a_get([
        H1Header { name: "Upgrade", value: "websocket" },
        H1Header { name: "Connection", value: "Upgrade" },
        H1Header { name: "Sec-WebSocket-Key", value: "dG9vLXNob3J0" },
        H1Header { name: "Sec-WebSocket-Version", value: "13" }])
    match wshandshake.check_upgrade_request(short)
        Ok(_)  => test.fail("ten bytes is not sixteen")
        Err(e) =>
            match e
                MalformedKey(k) => test.assert(k == "dG9vLXNob3J0")
                _               => test.fail("the refusal quotes the key")

    test.case("a version that is not a number")
    let unparseable = a_get(upgrade_fields("thirteen"))
    match wshandshake.check_upgrade_request(unparseable)
        Ok(_)  => test.fail("thirteen is not the version this package speaks")
        Err(e) =>
            match e
                UnsupportedVersion(v) => test.assert(v == 0)
                _                     => test.fail("the refusal names the version")

@test
fn test_the_field_values_a_request_carries_are_read_as_lists() [io]
    test.case("two copies, one of them a list, and an empty element")
    let offered = a_get([
        H1Header { name: "Upgrade", value: "websocket" },
        H1Header { name: "Connection", value: "keep-alive, Upgrade" },
        H1Header { name: "Sec-WebSocket-Key", value: the_rfc_client_key() },
        H1Header { name: "Sec-WebSocket-Version", value: "13" },
        H1Header { name: "Sec-WebSocket-Protocol", value: "chat, superchat" },
        H1Header { name: "Sec-WebSocket-Protocol", value: " , trailing" },
        H1Header { name: "Sec-WebSocket-Extensions", value: "permessage-deflate" }])
    match wshandshake.check_upgrade_request(offered)
        Err(_) => test.fail("that is a well-formed upgrade")
        Ok(u)  =>
            test.assert(u.version == 13)
            test.assert(list.len(u.protocols) == 3)
            test.assert(u.protocols[0] == "chat")
            test.assert(u.protocols[1] == "superchat")
            test.assert(u.protocols[2] == "trailing")
            test.assert(list.len(u.extensions) == 1)
            test.assert(u.extensions[0] == "permessage-deflate")

@test
fn test_the_client_s_request_writes_the_protocols_it_was_offered() [io]
    test.case("no protocols is no field")
    match wshandshake.upgrade_request("server.example.com", "/chat", the_rfc_client_key(), [])
        Err(_)  => test.fail("the RFC's key is sixteen bytes")
        Ok(req) =>
            match h1msg.get(req.headers, "sec-websocket-protocol")
                None    => test.assert(true)
                Some(_) => test.fail("an empty offer writes no field")

    test.case("two protocols is one field")
    match wshandshake.upgrade_request("server.example.com", "/chat", the_rfc_client_key(),
                                      ["chat", "superchat"])
        Err(_)  => test.fail("the RFC's key is sixteen bytes")
        Ok(req) =>
            match h1msg.get(req.headers, "sec-websocket-protocol")
                None    => test.fail("the offer is written")
                Some(v) => test.assert(v == "chat, superchat")

    test.case("and a key that is not sixteen bytes is refused before it is sent")
    match wshandshake.upgrade_request("server.example.com", "/chat", "too-short", [])
        Ok(_)  => test.fail("a malformed key is answered with a 400")
        Err(e) =>
            match e
                MalformedKey(k) => test.assert(k == "too-short")
                _               => test.fail("the refusal quotes the key")

@test
fn test_the_server_s_101_names_the_subprotocol_it_chose() [io]
    test.case("a chosen protocol is written")
    match wshandshake.upgrade_response(the_rfc_client_key(), Some("chat"))
        Err(_)   => test.fail("the RFC's key is sixteen bytes")
        Ok(resp) =>
            match h1msg.get(resp.headers, "sec-websocket-protocol")
                None    => test.fail("the chosen name is written")
                Some(v) => test.assert(v == "chat")

    test.case("and no protocol is no field")
    match wshandshake.upgrade_response(the_rfc_client_key(), None)
        Err(_)   => test.fail("the RFC's key is sixteen bytes")
        Ok(resp) =>
            match h1msg.get(resp.headers, "sec-websocket-protocol")
                None    => test.assert(true)
                Some(_) => test.fail("a server that chose none writes none")

    test.case("a bad key is refused")
    match wshandshake.upgrade_response("too-short", None)
        Ok(_)  => test.fail("a malformed key is answered with a 400")
        Err(e) =>
            match e
                MalformedKey(_) => test.assert(true)
                _               => test.fail("the refusal quotes the key")

@test
fn test_the_client_reads_back_the_answer_to_its_own_key() [io]
    test.case("a 101 with no subprotocol agrees on none")
    match wshandshake.check_upgrade_response(the_rfc_client_key(), [], a_101([]))
        Err(_)  => test.fail("that 101 answers the key that was sent")
        Ok(got) =>
            match got
                None    => test.assert(true)
                Some(_) => test.fail("no subprotocol was agreed")

    test.case("one that was offered is agreed")
    let offered = [H1Header { name: "Sec-WebSocket-Protocol", value: "superchat" }]
    match wshandshake.check_upgrade_response(the_rfc_client_key(), ["chat", "superchat"], a_101(offered))
        Err(_)  => test.fail("superchat was offered")
        Ok(got) =>
            match got
                None    => test.fail("the server chose superchat")
                Some(n) => test.assert(n == "superchat")

    test.case("an extension nobody offered is refused")
    let extended = [H1Header { name: "Sec-WebSocket-Extensions", value: "permessage-deflate" }]
    match wshandshake.check_upgrade_response(the_rfc_client_key(), [], a_101(extended))
        Ok(_)  => test.fail("this package negotiates no extensions")
        Err(e) =>
            match e
                UnrequestedExtension(name) => test.assert(name == "permessage-deflate")
                _                          => test.fail("the refusal names the extension")

