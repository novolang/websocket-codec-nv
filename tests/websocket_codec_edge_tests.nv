@test
fn test_a_non_four_byte_mask_key_is_refused_by_every_builder() [io]
    test.case("two bytes")
    match wswrite.text([0x48 as u8], Some([0x00 as u8, 0x01 as u8]))
        Ok(_)  => test.fail("a mask key is four bytes")
        Err(e) =>
            match e
                BadMaskKey(n) => test.assert(n == 2)
                _             => test.fail("the refusal names the length")

    test.case("an empty key is no mask and not a refusal")
    match wswrite.binary([0x00 as u8], Some([]))
        Ok(f)  => test.assert(not f.header.masked)
        Err(_) => test.fail("an empty key is a server's frame")

@test
fn test_a_control_frame_over_the_limit_is_refused_by_pong_too() [io]
    test.case("a pong over 125 bytes")
    let big = list.map(list.range(0, 126), i => 0 as u8)
    match wswrite.pong(big, None)
        Ok(_)  => test.fail("a control frame carries at most 125 bytes")
        Err(e) =>
            match e
                ControlPayloadTooLong(n) => test.assert(n == 126)
                _                        => test.fail("the refusal names the length")

@test
fn test_both_kinds_of_message_fragment_at_the_size_the_caller_chose() [io]
    test.case("a text message")
    let text = frames_of(TextMessage([0x48 as u8, 0x69 as u8, 0x21 as u8]), 2, [])
    test.assert(list.len(text) == 2)
    test.assert(text[0].header.opcode == TextFrame)
    test.assert(not text[0].header.fin)
    test.assert(text[1].header.opcode == Continuation)
    test.assert(text[1].header.fin)

    test.case("a binary message")
    let binary = frames_of(BinaryMessage([0x00 as u8, 0x01 as u8, 0x02 as u8]), 1, [])
    test.assert(list.len(binary) == 3)
    test.assert(binary[0].header.opcode == BinaryFrame)
    test.assert(binary[2].header.fin)

    test.case("a whole message as one buffer")
    match wswrite.bytes(BinaryMessage([0x00 as u8, 0x01 as u8, 0x02 as u8]), 4096, [])
        Err(_) => test.fail("three unmasked bytes are a frame")
        Ok(b)  =>
            // Two fixed bytes of header and three of payload.
            test.assert(list.len(b) == 5)
            test.assert((b[0] as Int) == 0x82)

// ── wsread ───────────────────────────────────────────────────────────

@test
fn test_a_fragmented_text_message_reassembles_across_feeds() [io]
    test.case("two fragments, then the message")
    let frames = frames_of(TextMessage([0x48 as u8, 0x69 as u8]), 1, [a_key(), a_key()])
    test.assert(list.len(frames) == 2)
    let first = wire_of(frames[0])
    let second = wire_of(frames[1])
    test.assert(list.len(first) > 0)
    test.assert(list.len(second) > 0)

    match wsread.feed(a_server_reader(), first)
        Err(_)   => test.fail("a masked fragment is what a server reads")
        Ok(step) =>
            match step.event
                None     => test.fail("a whole fragment is an event")
                Some(ev) =>
                    match ev
                        DataFrame(_) => test.assert(true)
                        _            => test.fail("the fragment arrives as a fragment")
            test.assert(wsread.message_open(step.reader))
            test.assert(wsread.assembling_len(step.reader) == 1)
            match wsread.feed(step.reader, second)
                Err(_)          => test.fail("the continuation is legal while a message is open")
                Ok(second_step) =>
                    let whole = wsread.take(second_step.reader)
                    match whole
                        Err(_)    => test.fail("the message is owed by the fin fragment")
                        Ok(step2) =>
                            match step2.event
                                None      => test.fail("a fin fragment completes the message")
                                Some(ev2) =>
                                    match ev2
                                        DataMessage(m) =>
                                            match m
                                                TextMessage(utf8) => test.assert(list.len(utf8) == 2)
                                                BinaryMessage(_)  => test.fail("a text frame owes a text message")
                                        _              => test.fail("the message follows the fragments")
                            test.assert(not wsread.message_open(step2.reader))

@test
fn test_a_binary_message_is_reported_as_binary() [io]
    test.case("one fin binary frame")
    let frames = frames_of(BinaryMessage([0x00 as u8]), 4096, [a_key()])
    test.assert(list.len(frames) == 1)
    let wire_bytes = wire_of(frames[0])
    test.assert(list.len(wire_bytes) > 0)
    match wsread.feed(a_server_reader(), wire_bytes)
        Err(_)   => test.fail("a masked binary frame is what a server reads")
        Ok(step) =>
            match wsread.take(step.reader)
                Err(_)   => test.fail("the fin frame owes a message")
                Ok(next) =>
                    match next.event
                        None     => test.fail("the message is owed")
                        Some(ev) =>
                            match ev
                                DataMessage(m) =>
                                    match m
                                        BinaryMessage(data) => test.assert(list.len(data) == 1)
                                        TextMessage(_)      => test.fail("a binary frame owes a binary message")
                                _              => test.fail("the message follows the frame")

@test
fn test_the_frame_rules_that_need_the_sequence_are_refused_by_the_reader() [io]
    test.case("a data frame inside a fragmented message")
    let fragment = wire_of(frames_of(TextMessage([0x48 as u8, 0x69 as u8]), 1, [a_key(), a_key()])[0])
    let other = wire_of(frames_of(BinaryMessage([0x00 as u8]), 4096, [a_key()])[0])
    match wsread.feed(a_server_reader(), fragment)
        Err(_)   => test.fail("a non-fin fragment opens a message")
        Ok(step) =>
            match wsread.feed(step.reader, other)
                Ok(_)  => test.fail("§ 5.4 forbids a second data frame there")
                Err(e) =>
                    match e
                        InterleavedDataFrame(code) => test.assert(code == 0x2)
                        _                          => test.fail("the refusal names the opcode")

    test.case("a continuation with no message open")
    let continuation = wire_of(frames_of(BinaryMessage([0x00 as u8]), 1, [a_key()])[0])
    let lone = match wswrite.continuation([0x01 as u8], false, Some(a_key()))
        Ok(f)  => wire_of(f)
        Err(_) => []
    test.assert(list.len(lone) > 0)
    match wsread.feed(a_server_reader(), lone)
        Ok(_)  => test.fail("a continuation starts nothing")
        Err(e) =>
            match e
                ContinuationWithoutStart => test.assert(true)
                _                        => test.fail("the refusal names the rule")

@test
fn test_a_ping_and_a_pong_are_events_the_message_state_survives() [io]
    test.case("a ping between the fragments")
    let frames = frames_of(TextMessage([0x48 as u8, 0x69 as u8]), 1, [a_key(), a_key()])
    let first = wire_of(frames[0])
    let second = wire_of(frames[1])
    let ping = match wswrite.ping([0x01 as u8], Some(a_key()))
        Ok(f)  => wire_of(f)
        Err(_) => []
    let pong = match wswrite.pong([0x01 as u8], Some(a_key()))
        Ok(f)  => wire_of(f)
        Err(_) => []
    test.assert(list.len(ping) > 0)
    test.assert(list.len(pong) > 0)

    match wsread.feed(a_server_reader(), first)
        Err(_)   => test.fail("a non-fin fragment opens a message")
        Ok(step) =>
            match wsread.feed(step.reader, ping)
                Err(_)     => test.fail("a control frame is legal between fragments")
                Ok(pinged) =>
                    match pinged.event
                        None     => test.fail("a whole ping is an event")
                        Some(ev) =>
                            match ev
                                ControlPing(payload) => test.assert(list.len(payload) == 1)
                                _                    => test.fail("the ping arrives as a ping")
                    test.assert(wsread.message_open(pinged.reader))
                    match wsread.feed(pinged.reader, pong)
                        Err(_)     => test.fail("a pong is legal there too")
                        Ok(ponged) =>
                            match ponged.event
                                None      => test.fail("a whole pong is an event")
                                Some(ev2) =>
                                    match ev2
                                        ControlPong(_) => test.assert(true)
                                        _              => test.fail("the pong arrives as a pong")
                            // The message is still open and the next
                            // fragment still completes it.
                            match wsread.feed(ponged.reader, second)
                                Err(_)   => test.fail("the continuation is still legal")
                                Ok(done) => test.assert(not wsread.message_open(done.reader))

@test
fn test_a_peer_close_ends_the_reader_and_nothing_follows_it() [io]
    test.case("a close frame with a code and a reason")
    let frame = match wswrite.close_frame(WsClose { code: NormalClosure, reason: "bye" }, Some(a_key()))
        Ok(f)  => wire_of(f)
        Err(_) => []
    test.assert(list.len(frame) > 0)
    match wsread.feed(a_server_reader(), frame)
        Err(_)   => test.fail("1000 with a short reason is an ordinary close")
        Ok(step) =>
            match step.event
                None     => test.fail("a whole close frame is an event")
                Some(ev) =>
                    match ev
                        PeerClose(c) =>
                            test.assert(wsclose.number_of(c.code) == 1000)
                            test.assert(c.reason == "bye")
                        _            => test.fail("the close arrives as a close")
            test.assert(wsread.closed(step.reader))
            match wsread.feed(step.reader, masked_hello())
                Ok(_)  => test.fail("nothing legal follows a close frame")
                Err(e) =>
                    match e
                        FrameAfterClose(code) => test.assert(code == 1000)
                        _                     => test.fail("the refusal names the close code")

@test
fn test_an_incomplete_length_field_is_kept_rather_than_refused() [io]
    test.case("two bytes of a 16-bit length")
    let two = [0x82 as u8, 0x7E as u8]
    match wsread.feed(a_server_reader(), two)
        Err(_)   => test.fail("a partial length is not a fault")
        Ok(step) =>
            test.assert(not wsread.closed(step.reader))
            match step.event
                None    => test.assert(true)
                Some(_) => test.fail("no frame is complete yet")
            test.assert(wsread.pending_len(step.reader) == 2)

    test.case("eight length bytes with the top bit set never complete")
    let impossible = [0x82 as u8, 0xFF as u8, 0x80 as u8, 0x00 as u8,
                      0x00 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8,
                      0x00 as u8, 0x00 as u8]
    match wsread.feed(a_server_reader(), impossible)
        Err(_)   => test.fail("a length that can never arrive is not a fault yet")
        Ok(step) =>
            match step.event
                None    => test.assert(true)
                Some(_) => test.fail("no frame is complete")

    test.case("a length the frame limit refuses on arrival")
    let declared = [0x82 as u8, 0x7F as u8,
                    0x00 as u8, 0x00 as u8, 0x00 as u8, 0x00 as u8,
                    0x00 as u8, 0x01 as u8, 0x00 as u8, 0x00 as u8]
    let tiny = WsLimits { max_frame: 1024, max_message: 1024 }
    match wsread.feed(wsread.reader(ServerSide, tiny), declared)
        Ok(_)  => test.fail("65536 bytes is past a cap of 1024")
        Err(e) =>
            match e
                FrameTooLong(len, cap) =>
                    test.assert(len == 65536)
                    test.assert(cap == 1024)
                _                      => test.fail("the refusal names the length and the cap")

@test
fn test_a_message_past_the_limit_is_refused_and_the_reader_never_grows() [io]
    test.case("two fragments past max_message")
    let limits = WsLimits { max_frame: 1024, max_message: 3 }
    let frames = frames_of(BinaryMessage([0x00 as u8, 0x01 as u8, 0x02 as u8, 0x03 as u8]), 2, [a_key(), a_key()])
    test.assert(list.len(frames) == 2)
    let first = wire_of(frames[0])
    let second = wire_of(frames[1])
    test.assert(list.len(first) > 0)
    test.assert(list.len(second) > 0)
    match wsread.feed(wsread.reader(ServerSide, limits), first)
        Err(_)   => test.fail("two bytes are inside a cap of three")
        Ok(step) =>
            match wsread.feed(step.reader, second)
                Ok(_)  => test.fail("four bytes are past a cap of three")
                Err(e) =>
                    match e
                        MessageTooLong(len, cap) =>
                            test.assert(len == 4)
                            test.assert(cap == 3)
                        _                        => test.fail("the refusal names the length and the cap")

@test
fn test_utf8_is_checked_at_every_kind_of_sequence() [io]
    test.case("one byte")
    test.assert(wsread.is_valid_utf8([0x00 as u8]))
    test.assert(wsread.is_valid_utf8([0x7F as u8]))

    test.case("two bytes")
    test.assert(wsread.is_valid_utf8([0xC2 as u8, 0x80 as u8]))
    test.assert(not wsread.is_valid_utf8([0xC1 as u8, 0x80 as u8]))
    test.assert(not wsread.is_valid_utf8([0xC2 as u8, 0x7F as u8]))

    test.case("three bytes, including the two narrow lead bytes")
    test.assert(wsread.is_valid_utf8([0xE0 as u8, 0xA0 as u8, 0x80 as u8]))
    test.assert(not wsread.is_valid_utf8([0xE0 as u8, 0x9F as u8, 0x80 as u8]))
    test.assert(wsread.is_valid_utf8([0xE1 as u8, 0x80 as u8, 0x80 as u8]))
    test.assert(wsread.is_valid_utf8([0xED as u8, 0x9F as u8, 0xBF as u8]))
    test.assert(not wsread.is_valid_utf8([0xED as u8, 0xA0 as u8, 0x80 as u8]))
    test.assert(wsread.is_valid_utf8([0xEF as u8, 0xBF as u8, 0xBF as u8]))
    test.assert(not wsread.is_valid_utf8([0xE1 as u8, 0x80 as u8, 0x7F as u8]))

    test.case("four bytes, including the last lead byte")
    test.assert(wsread.is_valid_utf8([0xF0 as u8, 0x90 as u8, 0x80 as u8, 0x80 as u8]))
    test.assert(not wsread.is_valid_utf8([0xF0 as u8, 0x8F as u8, 0x80 as u8, 0x80 as u8]))
    test.assert(wsread.is_valid_utf8([0xF1 as u8, 0x80 as u8, 0x80 as u8, 0x80 as u8]))
    test.assert(wsread.is_valid_utf8([0xF4 as u8, 0x8F as u8, 0xBF as u8, 0xBF as u8]))
    test.assert(not wsread.is_valid_utf8([0xF4 as u8, 0x90 as u8, 0x80 as u8, 0x80 as u8]))

    test.case("a sequence the buffer cuts short")
    test.assert(not wsread.is_valid_utf8([0xE1 as u8, 0x80 as u8]))

    test.case("and a byte that leads nothing")
    test.assert(not wsread.is_valid_utf8([0xF5 as u8]))
    test.assert(not wsread.is_valid_utf8([0xFF as u8]))

// ── wsread.drain ─────────────────────────────────────────────────────

// A source that fails instead of running out: the one answer `drain`
// has to tell apart from an exhausted stream, and the only one no
// in-memory buffer gives.
struct BrokenSource
    reads: Int

impl Read[] for BrokenSource
    fn read(self, n: Int) -> Result<Bytes, IoError>
        let _ = n
        Err(IoOther("the transport went away"))

@test
fn test_two_frames_in_one_chunk_leave_the_second_where_it_landed() [io]
    test.case("both frames in one feed")
    let both = list.concat(masked_hello(), masked_hello())
    match wsread.feed(a_server_reader(), both)
        Err(_)   => test.fail("the first frame is whole inside that chunk")
        Ok(step) =>
            match step.event
                None     => test.fail("the first frame is whole")
                Some(ev) =>
                    match ev
                        DataFrame(_) => test.assert(true)
                        _            => test.fail("a data frame arrives first")
            // The second frame is held whole and unread: eleven bytes.
            test.assert(wsread.pending_len(step.reader) == 11)
            match wsread.take(step.reader)
                Err(_)  => test.fail("the first frame owes a message")
                Ok(msg) =>
                    match msg.event
                        None      => test.fail("the message is owed")
                        Some(ev2) =>
                            match ev2
                                DataMessage(_) => test.assert(true)
                                _              => test.fail("the message follows its frame")
                    // And the held frame is still there to be read.
                    match wsread.take(msg.reader)
                        Err(_)     => test.fail("the second frame is whole and held")
                        Ok(second) =>
                            match second.event
                                None      => test.fail("the second frame is whole")
                                Some(ev3) =>
                                    match ev3
                                        DataFrame(_) => test.assert(true)
                                        _            => test.fail("the frame is next, before its message")

@test
fn test_the_declared_length_is_read_before_the_body_is_asked_for() [io]
    // `frame_step` asks the length field for its size before it asks the
    // buffer whether the frame is whole, which is what refuses a
    // declared gigabyte before the gigabyte arrives.
    test.case("four bytes of a 16-bit length")
    let four = [0x82 as u8, 0x7E as u8, 0x00 as u8, 0x02 as u8]
    match wsread.feed(a_server_reader(), four)
        Err(_)   => test.fail("two bytes is a legal declared length")
        Ok(step) =>
            test.assert(not wsread.closed(step.reader))
            match step.event
                None    => test.assert(true)
                Some(_) => test.fail("the body has not arrived")

    test.case("three bytes of a 64-bit length")
    let three = [0x82 as u8, 0x7F as u8, 0x00 as u8]
    match wsread.feed(a_server_reader(), three)
        Err(_)   => test.fail("a length that has not arrived is not a fault")
        Ok(step) =>
            match step.event
                None    => test.assert(true)
                Some(_) => test.fail("the length field is incomplete")

@test
fn test_drain_holds_a_prefix_that_never_completes() [io]
    test.case("a source that ends one byte into a frame")
    // Where the frame is not a fault and not an event: the byte stays
    // held for whoever continues the stream.
    let src = Buffer.from_str("\x81")
    match wsread.drain(a_server_reader(), src)
        Err(_) => test.fail("an exhausted source is not a fault")
        Ok(d)  =>
            test.assert(list.len(d.events) == 0)
            test.assert(wsread.pending_len(d.reader) == 1)
            test.assert(not wsread.closed(d.reader))
    src.drop()

@test
fn test_drain_reports_every_event_a_source_holds() [io]
    test.case("a whole masked message in one buffer")
    // The RFC's example frame as the bytes a client would have sent.
    let src = Buffer.from_str("\x81\x85\x37\xFA\x21\x3D\x7F\x9F\x4D\x51\x58")
    match wsread.drain(a_server_reader(), src)
        Err(_) => test.fail("that is a whole masked text message")
        Ok(d)  =>
            test.assert(list.len(d.events) == 2)
            test.assert(wsread.pending_len(d.reader) == 0)
            test.assert(wsread.assembling_len(d.reader) == 0)
    src.drop()

@test
fn test_drain_ends_at_a_transport_failure_with_what_it_has() [io]
    test.case("a source whose read fails")
    match wsread.drain(a_server_reader(), BrokenSource { reads: 0 })
        Err(_) => test.fail("a failed transport is not a decode fault")
        Ok(d)  =>
            test.assert(list.len(d.events) == 0)
            test.assert(not wsread.closed(d.reader))
